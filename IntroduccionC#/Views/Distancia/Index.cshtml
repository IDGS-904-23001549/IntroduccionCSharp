@model IntroduccionC_.Models.Distancia
@{
    ViewBag.Title = "Distancia entre puntos";
}

<h2>Calculadora de Distancia</h2>

<div class="container">
    <form action="/Distancia/Index" method="post">
        <div class="row">
            <div class="col-md-3">
                <h4>Punto 1</h4>
                <label>X1: </label>
                <input type="text" name="X1" value="" class="form-control" />
                <label>Y1: </label>
                <input type="text" name="Y1" value="" class="form-control" />
            </div>
            <div class="col-md-3">
                <h4>Punto 2</h4>
                <label>X2: </label>
                <input type="text" name="X2" value="" class="form-control" />
                <label>Y2: </label>
                <input type="text" name="Y2" value="" class="form-control" />
            </div>
        </div>
        <br />
        <input type="submit" value="Calcular Distancia" class="btn btn-success" />
    </form>

    <hr />
    <h3>La distancia es: @Html.DisplayFor(model => model.Resultado)</h3>
</div>